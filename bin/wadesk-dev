#!/usr/bin/env bash
# WaDesk development helper. Runs everything inside the dev toolbox container.
#
#   bin/wadesk-dev setup                  build toolbox, install gems + packages, prepare dev/test databases
#   bin/wadesk-dev rspec [files...]       run backend specs (RAILS_ENV=test)
#   bin/wadesk-dev rubocop [args...]      lint Ruby
#   bin/wadesk-dev pnpm <args...>         run pnpm (e.g. `pnpm test`, `pnpm eslint`)
#   bin/wadesk-dev sh                     shell inside the toolbox
#   bin/wadesk-dev server                 run Chatwoot (http://localhost:3300) + engine (http://localhost:4400) + mail (:8025)
#   bin/wadesk-dev ui-bundle              download the latest frontend bundle built on GitHub (workflow "WaDesk UI bundle")
#   bin/wadesk-dev server-prebuilt        Chatwoot + engine using that bundle, without compiling the frontend (low memory)
#   bin/wadesk-dev smoke                  check the running stack is wired up (run before every demo)
#   bin/wadesk-dev down                   stop everything (data volumes are kept)
#   bin/wadesk-dev engine <pnpm args>    run pnpm in wadesk-engine against the dev Postgres (e.g. `engine test`)
#   bin/wadesk-dev pre-commit             Chatwoot's pre-commit checks (.husky/pre-commit), run in the toolbox
#
# Uses docker compose; on this laptop it talks to rootless Podman when DOCKER_HOST is unset.
set -euo pipefail
cd "$(dirname "$0")/.."

# Inside a Flatpak sandbox (e.g. VS Code's terminal) there is no container CLI: re-run on the host.
if ! command -v docker >/dev/null && command -v flatpak-spawn >/dev/null; then
  exec flatpak-spawn --host ${WADESK_GH_USER:+--env=WADESK_GH_USER="$WADESK_GH_USER"} "$PWD/bin/wadesk-dev" "$@"
fi

if [ -z "${DOCKER_HOST:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/podman/podman.sock" ]; then
  export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/podman/podman.sock"
fi
compose() { docker compose -f docker-compose.wadesk-dev.yaml "$@"; }
# Tests use their own Redis database so the dev worker never picks up jobs enqueued by specs.
TEST_ENV=(-e RAILS_ENV=test -e REDIS_URL=redis://redis:6379/1)
run() { compose up -d --wait toolbox >/dev/null 2>&1 && compose exec -T "$@"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup)
    compose build toolbox
    run toolbox sh -c 'bundle install --jobs 4 && pnpm install --frozen-lockfile && pnpm --dir wadesk-engine install --frozen-lockfile'
    run -e RAILS_ENV=development toolbox bundle exec rails db:prepare
    run "${TEST_ENV[@]}" toolbox bundle exec rails db:prepare
    # pnpm install points git at .husky, whose hook needs Node/Ruby on the host; use the toolbox wrapper instead.
    git config core.hooksPath .githooks
    ;;
  rspec)   run "${TEST_ENV[@]}" toolbox bundle exec rspec "$@" ;;
  rubocop) run toolbox bundle exec rubocop "$@" ;;
  pnpm)    run toolbox pnpm "$@" ;;
  sh)      compose up -d --wait toolbox >/dev/null 2>&1 && compose exec toolbox bash ;;
  server)  compose --profile app up web worker vite engine mailpit ;;
  ui-bundle)
    rm -rf public/vite-dev
    # Needs a gh login with access to the repo; set WADESK_GH_USER to pick a non-active gh account.
    GH_TOKEN="${GH_TOKEN:-$(gh auth token ${WADESK_GH_USER:+--user "$WADESK_GH_USER"})}" \
      gh run download --repo "${WADESK_REPO:-Ayush7725/wadesk}" --name wadesk-ui-bundle --dir public/vite-dev
    echo "Frontend bundle ready in public/vite-dev" ;;
  server-prebuilt)
    [ -f public/vite-dev/.vite/manifest.json ] || [ -f public/vite-dev/manifest.json ] || { echo "Run bin/wadesk-dev ui-bundle first"; exit 1; }
    compose --profile prebuilt up web-prebuilt worker engine mailpit ;;
  smoke)
    # Checks the pieces reach each other the way the running mode wires them (docs/wadesk/README.md, DoD rule 6).
    rails=$(compose ps --status running --services | grep -xE 'web|web-prebuilt' || true)
    [ -n "$rails" ] || { echo "FAIL Chatwoot is not running (bin/wadesk-dev server or server-prebuilt)"; exit 1; }
    check() { if eval "$2" >/dev/null 2>&1; then echo "ok   $1"; else echo "FAIL $1"; failed=1; fi; }
    failed=0
    check "Chatwoot answers on http://localhost:3300" "curl -sf -o /dev/null http://localhost:3300/"
    check "engine answers on http://localhost:4400" "curl -sf -o /dev/null http://localhost:4400/health"
    check "Chatwoot ($rails) reaches the engine at WADESK_ENGINE_URL" \
      "compose exec -T $rails ruby -rnet/http -e 'exit Net::HTTP.get_response(URI(ENV.fetch(\"WADESK_ENGINE_URL\") + \"/health\")).is_a?(Net::HTTPSuccess)'"
    callback=$(compose exec -T "$rails" printenv WADESK_ENGINE_CALLBACK_BASE_URL | tr -d '\r')
    check "engine reaches Chatwoot's webhooks at $callback" \
      "compose exec -T engine node -e 'fetch(process.argv[1]).then(r => process.exit(r.status < 500 ? 0 : 1), () => process.exit(1))' '$callback'"
    # A real email through Chatwoot's own mail settings: merely connecting passed while delivery still failed.
    check "Chatwoot ($rails) delivers email to the mail catcher" \
      "compose exec -T $rails bundle exec rails runner 'ActionMailer::Base.mail(from: \"smoke@wadesk.local\", to: \"smoke@wadesk.local\", subject: \"WaDesk smoke check\", body: \"ok\").deliver_now'"
    check "mail catcher answers on http://localhost:8025" "curl -sf -o /dev/null http://localhost:8025/"
    if [ "$rails" = web-prebuilt ]; then
      check "prebuilt frontend bundle present" "[ -f public/vite-dev/.vite/manifest.json ]"
    fi
    exit "$failed" ;;
  down)    compose --profile app --profile prebuilt down ;;
  pre-commit) run toolbox sh .husky/pre-commit ;;
  engine)  run -w /app/wadesk-engine -e WADESK_ENGINE_DATABASE_URL=postgres://postgres@db:5432/wadesk_engine_test toolbox pnpm "$@" ;;
  *)       sed -n '2,17p' "$0" ;;
esac
