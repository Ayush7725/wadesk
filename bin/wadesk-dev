#!/usr/bin/env bash
# WaDesk development helper. Runs everything inside the dev toolbox container.
#
#   bin/wadesk-dev setup                  build toolbox, install gems + packages, prepare dev/test databases
#   bin/wadesk-dev rspec [files...]       run backend specs (RAILS_ENV=test)
#   bin/wadesk-dev rubocop [args...]      lint Ruby
#   bin/wadesk-dev pnpm <args...>         run pnpm (e.g. `pnpm test`, `pnpm eslint`)
#   bin/wadesk-dev sh                     shell inside the toolbox
#   bin/wadesk-dev server                 run Chatwoot dev server on http://localhost:3300
#   bin/wadesk-dev down                   stop everything (data volumes are kept)
#   bin/wadesk-dev pre-commit             Chatwoot's pre-commit checks (.husky/pre-commit), run in the toolbox
#
# Uses docker compose; on this laptop it talks to rootless Podman when DOCKER_HOST is unset.
set -euo pipefail
cd "$(dirname "$0")/.."

# Inside a Flatpak sandbox (e.g. VS Code's terminal) there is no container CLI: re-run on the host.
if ! command -v docker >/dev/null && command -v flatpak-spawn >/dev/null; then
  exec flatpak-spawn --host "$PWD/bin/wadesk-dev" "$@"
fi

if [ -z "${DOCKER_HOST:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/podman/podman.sock" ]; then
  export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/podman/podman.sock"
fi
compose() { docker compose -f docker-compose.wadesk-dev.yaml "$@"; }
run() { compose up -d --wait toolbox >/dev/null && compose exec -T "$@"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  setup)
    compose build toolbox
    run toolbox sh -c 'bundle install --jobs 4 && pnpm install --frozen-lockfile'
    run -e RAILS_ENV=development toolbox bundle exec rails db:prepare
    run -e RAILS_ENV=test toolbox bundle exec rails db:prepare
    # pnpm install points git at .husky, whose hook needs Node/Ruby on the host; use the toolbox wrapper instead.
    git config core.hooksPath .githooks
    ;;
  rspec)   run -e RAILS_ENV=test toolbox bundle exec rspec "$@" ;;
  rubocop) run toolbox bundle exec rubocop "$@" ;;
  pnpm)    run toolbox pnpm "$@" ;;
  sh)      compose up -d --wait toolbox >/dev/null && compose exec toolbox bash ;;
  server)  compose --profile app up web worker vite ;;
  down)    compose --profile app down ;;
  pre-commit) run toolbox sh .husky/pre-commit ;;
  *)       sed -n '2,13p' "$0" ;;
esac
