<%# WaDesk: operator console sidebar (desktop). The same links appear in _topbar on small screens. %>
<aside class="hidden md:flex w-60 flex-none flex-col gap-6 border-e border-n-weak bg-n-solid-1 px-3 py-5 sticky top-0 h-screen" aria-label="Operator console">
  <%= link_to super_admin_root_path, class: 'flex items-center gap-2.5 px-2' do %>
    <span class="grid size-8 place-content-center rounded-lg bg-n-brand text-white" aria-hidden="true">
      <svg class="size-4"><use xlink:href="#icon-whatsapp-line" /></svg>
    </span>
    <span>
      <span class="block text-sm font-semibold text-n-slate-12">WaDesk</span>
      <span class="block text-xs text-n-slate-10">Operator Console</span>
    </span>
  <% end %>

  <nav class="flex flex-col gap-0.5">
    <span class="px-2.5 pb-1.5 text-xs font-medium uppercase tracking-wider text-n-slate-10">Manage</span>
    <% console_nav_links.each do |link| %>
      <%= render 'super_admin/wadesk_console/nav_link', **link %>
    <% end %>
  </nav>

  <nav class="flex flex-col gap-0.5">
    <span class="px-2.5 pb-1.5 text-xs font-medium uppercase tracking-wider text-n-slate-10">Advanced</span>
    <% console_advanced_links.each do |link| %>
      <%= render 'super_admin/wadesk_console/nav_link', **link %>
    <% end %>
  </nav>

  <div class="mt-auto flex items-center gap-2.5 border-t border-n-weak px-2 pt-3">
    <span class="grid size-8 flex-none place-content-center rounded-full bg-n-blue-3 text-xs font-semibold text-n-blue-11" aria-hidden="true">
      <%= current_super_admin.name.to_s.split.map(&:first).first(2).join.upcase %>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-medium"><%= current_super_admin.name %></span>
      <span class="block truncate text-xs text-n-slate-10"><%= current_super_admin.email %></span>
    </span>
    <%= link_to super_admin_logout_path, class: 'text-n-slate-10 hover:text-n-slate-12', title: 'Log out', 'aria-label': 'Log out' do %>
      <svg class="size-4" aria-hidden="true"><use xlink:href="#icon-logout-circle-r-line" /></svg>
    <% end %>
  </div>
</aside>
