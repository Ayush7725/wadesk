<%# WaDesk: one sidebar link. Locals: label, url, icon (sprite id), active (bool), badge (optional count). %>
<%= link_to url, class: "flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg text-sm font-medium #{active ? 'bg-n-blue-3 text-n-blue-11' : 'text-n-slate-11 hover:bg-n-alpha-2 hover:text-n-slate-12'}",
                 'aria-current': (active ? 'page' : nil) do %>
  <svg class="size-4 flex-none" aria-hidden="true"><use xlink:href="#<%= icon %>" /></svg>
  <span class="truncate"><%= label %></span>
  <% if local_assigns[:badge].to_i.positive? %>
    <span class="ms-auto rounded-full bg-n-ruby-3 px-1.5 text-xs font-semibold text-n-ruby-11 tabular-nums"><%= badge %></span>
  <% end %>
<% end %>
