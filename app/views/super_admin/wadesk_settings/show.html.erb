<%# WaDesk: installation-wide settings the operator may change (Wadesk::InstallationSettings, CR-004). Works without JavaScript. %>
<% content_for(:title) { 'Settings' } %>
<% errors = @errors || {} %>
<% signup = Wadesk::InstallationSettings::SIGNUP %>
<% branding_editable = Wadesk::InstallationSettings.branding_editable? %>
<% input_class = 'mt-1 block w-full rounded-lg border bg-n-solid-2 px-3 py-2 text-sm text-n-slate-12 outline-none focus:border-n-brand focus:ring-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand' %>

<%= render 'super_admin/wadesk_console/page_header', title: 'Settings', description: 'Settings that apply to the whole WaDesk installation.' %>

<%= form_with scope: :settings, url: super_admin_wadesk_settings_path, method: :patch, local: true,
              class: 'max-w-3xl rounded-xl border border-n-weak bg-n-solid-1', data: { settings_form: true } do |f| %>
  <section class="flex flex-col gap-3 p-4 sm:p-5" aria-labelledby="signup-title">
    <div>
      <h2 id="signup-title" class="text-sm font-semibold text-n-slate-12">Sign-ups</h2>
      <p class="mt-0.5 text-xs text-n-slate-11">Who can create a new client account.</p>
    </div>
    <%= render 'super_admin/wadesk_clients/switch', name: "settings[#{signup.key}]", id: "settings_#{signup.key}", card: true,
                                                   checked: [true, '1'].include?(@values[signup.key]), label: signup.label, description: signup.hint %>
    <% if errors[signup.key] %>
      <p class="text-xs text-n-ruby-11" role="alert"><%= signup.label %> <%= errors[signup.key] %>.</p>
    <% end %>
  </section>

  <section class="flex flex-col gap-4 border-t border-n-weak p-4 sm:p-5" aria-labelledby="brand-title" data-section="brand">
    <div>
      <h2 id="brand-title" class="text-sm font-semibold text-n-slate-12">Brand</h2>
      <p class="mt-0.5 text-xs text-n-slate-11">What your clients see: names, links and logos in the app, emails and the chat widget.</p>
    </div>

    <% unless branding_editable %>
      <p class="rounded-lg bg-n-amber-3 px-3 py-2.5 text-sm text-n-amber-11" data-brand-locked>
        Brand settings cannot be changed on this server yet: Chatwoot's enterprise edition is installed without a paid plan, and it puts
        Chatwoot's own brand back every night. Ask your developer to switch the enterprise edition off (DISABLE_ENTERPRISE=true);
        these settings then become editable here.
      </p>
    <% end %>

    <% Wadesk::InstallationSettings::BRAND.each do |setting| %>
      <% id = "settings_#{setting.key}" %>
      <% error = errors[setting.key] %>
      <div data-setting="<%= setting.key %>">
        <%= content_tag(branding_editable ? :label : :p, setting.label, for: (id if branding_editable), class: 'text-sm font-medium text-n-slate-12') %>
        <p id="<%= id %>-hint" class="text-xs text-n-slate-11"><%= setting.hint %></p>
        <% if branding_editable %>
          <%= text_field_tag "settings[#{setting.key}]", @values[setting.key], id: id, required: true,
                             maxlength: Wadesk::InstallationSettings::TEXT_MAX_LENGTH,
                             type: (setting.kind == :url ? 'url' : 'text'), inputmode: (setting.kind == :text ? nil : 'url'),
                             autocomplete: 'off', spellcheck: false,
                             'aria-describedby': ["#{id}-hint", ("#{id}-error" if error)].compact.join(' '),
                             'aria-invalid': (error ? true : nil),
                             class: "#{input_class} #{error ? 'border-n-ruby-8' : 'border-n-weak'}" %>
          <% if error %>
            <p id="<%= id %>-error" class="mt-1 text-xs text-n-ruby-11"><%= setting.label %> <%= error %>.</p>
          <% end %>
        <% else %>
          <p class="mt-1 break-all rounded-lg border border-n-weak bg-n-alpha-1 px-3 py-2 text-sm text-n-slate-11"><%= @values[setting.key].presence || '—' %></p>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="flex flex-wrap items-center justify-end gap-2.5 rounded-b-xl border-t border-n-weak px-4 py-3 sm:px-5">
    <%= link_to 'Discard', super_admin_wadesk_settings_path,
                class: 'rounded-lg border border-n-weak bg-n-solid-1 px-3 py-1.5 text-sm font-medium text-n-slate-12 hover:bg-n-alpha-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand' %>
    <%= f.submit 'Save settings', name: nil,
                 class: 'cursor-pointer rounded-lg border border-n-brand bg-n-brand px-3 py-1.5 text-sm font-medium text-white hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-n-brand' %>
  </div>
<% end %>
