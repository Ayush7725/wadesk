<%# WaDesk: delete a client after typing its name. Locals: danger_button (classes). %>
<section class="mt-6 rounded-xl border border-n-ruby-6 bg-n-solid-1" aria-labelledby="danger-title" data-danger-zone>
  <div class="border-b border-n-ruby-6 px-4 py-3.5 sm:px-5">
    <h2 id="danger-title" class="text-sm font-semibold text-n-ruby-11">Danger zone</h2>
  </div>
  <div class="grid gap-4 px-4 py-4 sm:px-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div id="delete-effects" class="text-sm text-n-slate-11">
      <p class="font-medium text-n-slate-12">Delete this client</p>
      <p class="mt-1">
        Permanently deletes the client's conversations, messages, contacts, inboxes, WhatsApp numbers (WhatsApp Web phones are
        unlinked), campaigns, reports and settings. Its team members lose access to it; their logins stay, as they may belong to
        other clients. This cannot be undone.
      </p>
    </div>
    <%= form_with url: super_admin_wadesk_client_path(@account), method: :delete, local: true,
                  class: 'flex flex-wrap items-end gap-2.5', data: { delete_form: true } do %>
      <div class="min-w-0 flex-[1_1_14rem]">
        <%= render 'text_field', name: 'confirm_name', id: 'confirm_name', label: "Type #{@account.name} to confirm",
                                value: (@delete_confirmation if @form_error[:delete]), autocomplete: 'off', required: true,
                                error: @form_error[:delete], extra: { spellcheck: false } %>
      </div>
      <button type="submit" class="<%= danger_button %>" aria-describedby="delete-effects">Delete client</button>
    <% end %>
  </div>
</section>
