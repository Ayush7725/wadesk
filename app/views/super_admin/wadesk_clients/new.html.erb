<% content_for(:title) do %>New client<% end %>
<% errors = @creation.errors %>
<% field_error = ->(attribute) { errors.full_messages_for(attribute).first } %>
<% min_password = Devise.password_length.min %>

<%= render 'super_admin/wadesk_console/page_header',
           title: 'New client',
           description: 'Creates the client\'s WaDesk account with the default features, and its first administrator.',
           back_path: super_admin_wadesk_clients_path, back_label: 'Clients' %>

<%= form_with scope: :client, url: super_admin_wadesk_clients_path, method: :post, local: true, id: 'new-client-form',
              class: 'max-w-2xl rounded-xl border border-n-weak bg-n-solid-1', 'aria-describedby': (errors.any? ? 'new-client-errors' : nil) do %>
  <% if errors.any? %>
    <div id="new-client-errors" class="m-4 rounded-lg bg-n-ruby-3 px-4 py-3 text-sm text-n-ruby-11 sm:m-5" role="alert" data-error-summary>
      <p class="font-medium">The client was not created. Fix <%= errors.count == 1 ? 'this' : 'these' %>:</p>
      <ul class="mt-1 list-disc ps-5">
        <% errors.each do |error| %>
          <li><a href="#client_<%= error.attribute %>" class="underline"><%= error.full_message %></a></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="flex flex-col gap-3.5 p-4 sm:p-5" aria-labelledby="business-title">
    <div>
      <h2 id="business-title" class="text-sm font-semibold text-n-slate-12">Business</h2>
      <p class="mt-0.5 text-xs text-n-slate-11">The name the client's team sees in WaDesk. You can rename it later.</p>
    </div>
    <%= render 'text_field', name: 'client[name]', id: 'client_name', label: 'Client name', value: @creation.name,
                            required: true, autocomplete: 'organization', error: field_error.call(:name) %>
  </section>

  <section class="flex flex-col gap-3.5 border-t border-n-weak p-4 sm:p-5" aria-labelledby="admin-title">
    <div>
      <h2 id="admin-title" class="text-sm font-semibold text-n-slate-12">First administrator</h2>
      <p class="mt-0.5 text-xs text-n-slate-11">
        This person manages the client's inboxes and team. If the email already has a WaDesk login, that user is added as
        the administrator and keeps their name and password.
      </p>
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2">
      <%= render 'text_field', name: 'client[admin_name]', id: 'client_admin_name', label: 'Admin name', value: @creation.admin_name,
                              autocomplete: 'off', error: field_error.call(:admin_name) %>
      <%= render 'text_field', name: 'client[admin_email]', id: 'client_admin_email', label: 'Admin email', value: @creation.admin_email,
                              type: 'email', required: true, autocomplete: 'off', error: field_error.call(:admin_email) %>
    </div>

    <div class="flex flex-col gap-3 rounded-lg border border-n-weak bg-n-solid-2 px-4 py-3.5">
      <div class="flex items-start gap-3">
        <%= hidden_field_tag 'client[set_password]', '0', id: nil %>
        <%= check_box_tag 'client[set_password]', '1', @creation.set_password, id: 'client_set_password',
                          'aria-describedby': 'client_set_password-description',
                          class: 'mt-0.5 size-4 flex-none rounded border-n-weak text-n-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand' %>
        <div class="min-w-0">
          <label for="client_set_password" class="cursor-pointer text-sm font-medium text-n-slate-12">Set a password now</label>
          <p id="client_set_password-description" class="text-xs text-n-slate-11">
            Off: we email an invitation and the administrator sets their own password.
            On: no email is sent; share the password with them yourself.
          </p>
        </div>
      </div>
      <div class="sm:max-w-xs" data-password-field>
        <%= render 'text_field', name: 'client[admin_password]', id: 'client_admin_password', label: 'Password', value: nil,
                                type: 'password', autocomplete: 'new-password', minlength: min_password,
                                hint: "Used only when \"Set a password now\" is on. At least #{min_password} characters, " \
                                      'with an uppercase letter, a lowercase letter, a number and a special character.',
                                error: field_error.call(:admin_password) %>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap items-center justify-end gap-2.5 rounded-b-xl border-t border-n-weak px-4 py-3 sm:px-5">
    <%= link_to 'Cancel', super_admin_wadesk_clients_path,
                class: 'rounded-lg border border-n-weak bg-n-solid-1 px-3 py-1.5 text-sm font-medium text-n-slate-12 hover:bg-n-alpha-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand' %>
    <button type="submit"
            class="cursor-pointer rounded-lg border border-n-brand bg-n-brand px-3 py-1.5 text-sm font-medium text-white hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-n-brand">
      Create client
    </button>
  </div>
<% end %>
