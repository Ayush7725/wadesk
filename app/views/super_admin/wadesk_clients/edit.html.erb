<% content_for(:title) do %><%= @account.name %><% end %>
<% default_limit = Wadesk::Safety::NewChatLimit::DEFAULT_DAILY_LIMIT %>
<% limit_range = SuperAdmin::WadeskClientsController::DAILY_NEW_CHATS_RANGE %>
<% plan_descriptions = { 'whatsapp_official' => 'Meta Cloud API, 360dialog, Twilio', 'whatsapp_web' => 'Phone linked by QR code or pairing code' } %>

<%= render 'super_admin/wadesk_console/page_header',
           title: @account.name,
           description: "##{@account.id} · client since #{@account.created_at.strftime('%-d %b %Y')}",
           back_path: super_admin_wadesk_clients_path, back_label: 'Clients',
           actions: (@account.active? ? console_pill('Active', :ok) : console_pill('Suspended', :mute)) %>

<div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
  <%= form_with scope: :client, url: super_admin_wadesk_client_path(@account), method: :patch, local: true,
                class: 'rounded-xl border border-n-weak bg-n-solid-1', data: { client_form: true, dirty: @limit_invalid.present? } do |f| %>
    <section class="flex flex-col gap-3.5 p-4 sm:p-5" aria-labelledby="plan-title">
      <div>
        <h2 id="plan-title" class="text-sm font-semibold text-n-slate-12">Plan</h2>
        <p class="mt-0.5 text-xs text-n-slate-11">What this client can add under Settings → Inboxes → WhatsApp.</p>
      </div>
      <% SuperAdmin::WadeskClientsController::PLAN_FEATURES.each do |feature, label| %>
        <% inbox_count = @inbox_counts[feature][@account.id].to_i %>
        <% existing = pluralize(inbox_count, 'existing inbox', plural: 'existing inboxes') %>
        <% keeps_working = "Turning #{label} off keeps its #{existing} working; only new #{label} inboxes are blocked." %>
        <%= render 'switch', name: "client[#{feature}]", id: "client_#{feature}", checked: @selected_plans.include?(feature), card: true,
                             label: label, description: "#{plan_descriptions[feature]} · #{inbox_count} existing",
                             warning: (keeps_working if @account.feature_enabled?(feature) && inbox_count.positive?) %>
      <% end %>
    </section>

    <section class="flex flex-col gap-3 border-t border-n-weak p-4 sm:p-5" aria-labelledby="limit-title">
      <div>
        <h2 id="limit-title" class="text-sm font-semibold text-n-slate-12">Daily new-chat limit</h2>
        <p class="mt-0.5 text-xs text-n-slate-11">
          How many new chats each WhatsApp Web number may start per day with people who never wrote in. Replies are never limited.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center overflow-hidden rounded-lg border border-n-weak bg-n-solid-1 focus-within:outline focus-within:outline-2 focus-within:outline-n-brand">
          <button type="button" hidden data-limit-step="-1" aria-label="Lower the limit"
                  class="h-9 w-9 text-base text-n-slate-11 hover:bg-n-alpha-2 focus-visible:bg-n-alpha-2 focus-visible:outline-none">−</button>
          <%= f.label :daily_new_chats, 'Daily new-chat limit', class: 'sr-only' %>
          <%= f.number_field :daily_new_chats, value: @daily_new_chats, min: limit_range.min, max: limit_range.max, step: 1,
                                               placeholder: default_limit.to_s, inputmode: 'numeric',
                                               'aria-describedby': 'limit-hint', 'aria-invalid': (@limit_invalid ? true : nil),
                                               data: { limit_input: true, default: default_limit },
                                               class: 'h-9 w-20 border-0 border-x border-n-weak bg-transparent px-2 text-center text-sm tabular-nums text-n-slate-12 outline-none focus:ring-0' %>
          <button type="button" hidden data-limit-step="1" aria-label="Raise the limit"
                  class="h-9 w-9 text-base text-n-slate-11 hover:bg-n-alpha-2 focus-visible:bg-n-alpha-2 focus-visible:outline-none">+</button>
        </div>
        <span id="limit-hint" class="text-xs text-n-slate-10">Leave empty to use the default (<%= default_limit %>).</span>
        <button type="button" hidden data-limit-reset
                class="rounded text-sm font-medium text-n-blue-11 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand">Use default</button>
      </div>
      <% if @limit_invalid %>
        <p class="text-xs text-n-ruby-11" data-field-error>
          Enter a whole number from <%= limit_range.min %> to <%= limit_range.max %>, or leave it empty for the default.
        </p>
      <% end %>
    </section>

    <section class="flex flex-col gap-4 border-t border-n-weak p-4 sm:p-5" aria-labelledby="features-title">
      <div>
        <h2 id="features-title" class="text-sm font-semibold text-n-slate-12">Features</h2>
        <p class="mt-0.5 text-xs text-n-slate-11">
          Turned-off features are hidden from this client's app. Their data is kept, and turning a feature back on restores it.
        </p>
      </div>
      <% Wadesk::ClientFeatures::GROUPS.each do |group| %>
        <fieldset class="min-w-0" data-feature-group="<%= group.title %>">
          <legend class="mb-1 text-xs font-medium uppercase tracking-wider text-n-slate-10"><%= group.title %></legend>
          <div class="divide-y divide-n-weak rounded-lg border border-n-weak bg-n-solid-2 px-4">
            <% group.features.each do |feature| %>
              <%= render 'switch', name: "client[features][#{feature.name}]", id: "client_features_#{feature.name}",
                                   checked: @selected_features.include?(feature.name), label: feature.label, description: feature.description,
                                   warning: (feature.off_warning if feature.off_warning && @account.feature_enabled?(feature.name)) %>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    </section>

    <div class="sticky bottom-0 flex flex-wrap items-center justify-end gap-2.5 rounded-b-xl border-t border-n-weak bg-n-solid-1 px-4 py-3 sm:px-5">
      <span class="me-auto text-sm text-n-slate-11" data-unsaved role="status">
        <%= 'Your changes are not saved yet.' if @limit_invalid %>
      </span>
      <%= link_to 'Discard', edit_super_admin_wadesk_client_path(@account),
                  class: 'rounded-lg border border-n-weak bg-n-solid-1 px-3 py-1.5 text-sm font-medium text-n-slate-12 hover:bg-n-alpha-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-n-brand' %>
      <%= f.submit 'Save changes', name: nil,
                   class: 'cursor-pointer rounded-lg border border-n-brand bg-n-brand px-3 py-1.5 text-sm font-medium text-white hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-n-brand' %>
    </div>
  <% end %>

  <div class="flex flex-col gap-4">
    <section class="rounded-xl border border-n-weak bg-n-solid-1" aria-labelledby="numbers-title">
      <div class="flex items-center justify-between gap-3 border-b border-n-weak px-4 py-3.5 sm:px-5">
        <h2 id="numbers-title" class="text-sm font-semibold text-n-slate-12">WhatsApp Web numbers</h2>
        <%= link_to 'All numbers', super_admin_whatsapp_web_numbers_path, class: 'text-sm font-medium text-n-blue-11 hover:underline' %>
      </div>
      <div class="px-4 py-3 sm:px-5">
        <% if @numbers.empty? %>
          <p class="text-sm text-n-slate-10">No WhatsApp Web numbers yet.</p>
        <% else %>
          <ul class="divide-y divide-n-weak">
            <% @numbers.each do |channel| %>
              <% state = whatsapp_web_state(channel) %>
              <li class="flex items-start justify-between gap-3 py-2.5" data-number-id="<%= channel.id %>">
                <div class="min-w-0">
                  <span class="font-medium text-n-slate-12"><%= channel.inbox&.name %></span>
                  <span class="ms-1 font-mono text-xs text-n-slate-10"><%= channel.phone_number %></span>
                  <% if state[:reason] %>
                    <span class="block text-xs text-n-slate-11"><%= state[:reason] %></span>
                  <% end %>
                </div>
                <%= whatsapp_web_state_pill(channel) %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>

    <section class="rounded-xl border border-n-weak bg-n-solid-1" aria-labelledby="account-title">
      <div class="border-b border-n-weak px-4 py-3.5 sm:px-5">
        <h2 id="account-title" class="text-sm font-semibold text-n-slate-12">Account</h2>
      </div>
      <dl class="grid grid-cols-1 gap-x-3 gap-y-2 px-4 py-4 text-sm sm:grid-cols-[8rem_minmax(0,1fr)] sm:px-5" data-account-facts>
        <dt class="text-n-slate-10">Official inboxes</dt>
        <dd class="tabular-nums"><%= @inbox_counts['whatsapp_official'][@account.id].to_i %></dd>
        <dt class="text-n-slate-10">Agents</dt>
        <dd class="tabular-nums"><%= @agents_count %></dd>
        <dt class="text-n-slate-10">Created</dt>
        <dd><%= @account.created_at.strftime('%-d %b %Y') %></dd>
        <dt class="text-n-slate-10">Account page</dt>
        <dd><%= link_to 'Open in Chatwoot admin', super_admin_account_path(@account), class: 'font-medium text-n-blue-11 hover:underline' %></dd>
      </dl>
    </section>
  </div>
</div>

<script>
  // Optional helpers; the form works without them. −/+ and "Use default" for the limit, and an unsaved-changes note.
  (function () {
    var form = document.querySelector('[data-client-form]');
    if (!form) return;
    var input = form.querySelector('[data-limit-input]');
    var status = form.querySelector('[data-unsaved]');
    var snapshot = function () { return new URLSearchParams(new FormData(form)).toString(); };
    var initial = snapshot();
    var refresh = function () {
      if (form.dataset.dirty === 'true' || snapshot() !== initial) status.textContent = 'You have unsaved changes';
      else status.textContent = '';
    };
    form.querySelectorAll('[data-limit-step], [data-limit-reset]').forEach(function (button) { button.hidden = false; });
    form.addEventListener('click', function (event) {
      var step = event.target.closest('[data-limit-step]');
      if (step) {
        var current = Math.round(Number(input.value)) || Number(input.dataset.default);
        input.value = Math.min(Number(input.max), Math.max(Number(input.min), current + Number(step.dataset.limitStep)));
      } else if (event.target.closest('[data-limit-reset]')) {
        input.value = '';
      } else {
        return;
      }
      refresh();
    });
    form.addEventListener('input', refresh);
    form.addEventListener('change', refresh);
  })();
</script>
